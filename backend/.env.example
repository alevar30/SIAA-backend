# Copiar a .env y completar con valores propios. Nunca subir .env a Git.
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=siaa_db

# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# El backend rechaza este marcador hasta que se reemplace.
SECRET_KEY=cambiar_por_una_clave_aleatoria_de_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
